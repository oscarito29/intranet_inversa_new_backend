DJANGO_SECRET_KEY=change-me
DB_NAME=intranet_inversa
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
REDIS_URL=redis://127.0.0.1:6379/1  # solo producción

# --- Solo producción ---
# DJANGO_SECRET_KEY: obligatoria, 50 caracteres o más y aleatoria (python -c "import secrets; print(secrets.token_urlsafe(64))").
# DJANGO_ALLOWED_HOSTS=intranet.ejemplo.com
# CORS_ALLOWED_ORIGINS=https://intranet.ejemplo.com
# AWS_STORAGE_BUCKET_NAME=intranet-inversa-archivos   # bucket PRIVADO; sin esto los archivos van al disco
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=       # opcionales: en AWS es mejor un rol de la máquina, sin claves
# S3_URL_EXPIRA_SEGUNDOS=28800                       # cuánto duran las direcciones firmadas (por defecto 8 horas)
# SENTRY_DSN=                                        # errores a Sentry; sin esto solo van a la consola
# SENTRY_ENVIRONMENT=production                      # etiqueta del entorno en Sentry
# APP_VERSION=                                       # versión desplegada (commit o etiqueta), para ubicar desde cuándo falla
# LOG_LEVEL=INFO                                     # DEBUG para investigar; nunca registra consultas SQL
# DJANGO_BEHIND_PROXY=true   # si un proxy o balanceador termina el HTTPS y manda X-Forwarded-Proto
# DRF_NUM_PROXIES=1          # cuántos proxies hay delante, para que el límite de intentos use la dirección real del cliente
# LOGIN_THROTTLE_RATE=20/min
# API_DOCS_ENABLED=false     # Swagger; apagado por defecto en producción
# ADMIN_ENABLED=false        # sitio /admin/ de Django; apagado por defecto en producción
