DJANGO_SECRET_KEY=change-me
DB_NAME=intranet_inversa
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
REDIS_URL=redis://127.0.0.1:6379/1  # solo producción

# --- Solo producción ---
# DJANGO_SECRET_KEY: obligatoria, 50 caracteres o más y aleatoria (python -c "import secrets; print(secrets.token_urlsafe(64))").
# DJANGO_ALLOWED_HOSTS=intranet.ejemplo.com
# CORS_ALLOWED_ORIGINS=https://intranet.ejemplo.com
# DJANGO_BEHIND_PROXY=true   # si un proxy o balanceador termina el HTTPS y manda X-Forwarded-Proto
# DRF_NUM_PROXIES=1          # cuántos proxies hay delante, para que el límite de intentos use la dirección real del cliente
# LOGIN_THROTTLE_RATE=20/min
# API_DOCS_ENABLED=false     # Swagger; apagado por defecto en producción
# ADMIN_ENABLED=false        # sitio /admin/ de Django; apagado por defecto en producción
